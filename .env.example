# ==============================================================================
# Life OS Environment Configuration
# ==============================================================================

# Application Port
PORT=3000

# PostgreSQL Database Configuration
POSTGRES_DB=lifeos
POSTGRES_USER=lifeos_user
POSTGRES_PASSWORD=replace_with_strong_password_here
DATABASE_URL=postgresql://lifeos_user:replace_with_strong_password_here@localhost:5432/lifeos?schema=public

# Ingestion Security API Key (used for iOS Shortcuts, Apple Watch & Webhooks)
# Generate a secure key, e.g. using `openssl rand -hex 24`
API_SECRET_KEY=lifeos_secret_token_change_me

# Seed starter data on first boot (set to false after initial initialization)
SEED_ON_BOOT=true

# ==============================================================================
# Hybrid AI Ingestion Engine
# Options for AI_PROVIDER: auto | ollama | gemini | claude | openai | rule_based
# In auto mode, Life OS tries local Ollama first, then Gemini/Claude/OpenAI,
# and falls back to deterministic offline regex parsing if no keys are set.
# ==============================================================================
AI_PROVIDER=auto

# 1. Local Open Source LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# 2. Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 3. Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# 4. OpenAI & Whisper (Audio Transcription)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
