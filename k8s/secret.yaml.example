apiVersion: v1
kind: Secret
metadata:
  name: lifeos-secrets
  namespace: lifeos
type: Opaque
stringData:
  # Generate a strong database password
  POSTGRES_PASSWORD: "change_this_postgres_password"
  
  # PostgreSQL Connection String used by Next.js & Prisma
  DATABASE_URL: "postgresql://lifeos_user:change_this_postgres_password@lifeos-postgres.lifeos.svc.cluster.local:5432/lifeos?schema=public"
  
  # API secret key for iOS Shortcut & webhook authentication
  API_SECRET_KEY: "change_this_to_a_random_32_character_secret"

  # Optional AI API keys (leave blank if relying on Ollama or offline parser)
  GEMINI_API_KEY: ""
  ANTHROPIC_API_KEY: ""
  OPENAI_API_KEY: ""
